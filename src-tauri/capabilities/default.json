{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "os:default",
    "dialog:default",
    "fs:default",
    "fs:read-files",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:read-all",
    "fs:write-files",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-app-write-recursive",
    "fs:write-all",
    "fs:allow-create",
    "fs:allow-rename",
    "fs:create-app-specific-dirs",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    "fs:allow-app-read-recursive",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-appconfig-read",
    "fs:allow-appconfig-write",
    "fs:allow-appconfig-meta-recursive",
    "fs:allow-appconfig-meta",
    "fs:scope-appconfig-recursive",
    "fs:scope-appconfig",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "process:default",
    "fs:allow-desktop-read-recursive",
    "fs:allow-desktop-meta-recursive",
    "fs:allow-resource-read-recursive",
    "fs:allow-resource-meta-recursive",
    "core:webview:allow-print",
    "sql:default"
  ]
}