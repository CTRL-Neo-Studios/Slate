{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "slate",
  "version": "0.1.0",
  "identifier": "dev.ctrl-neo",
  "build": {
    "frontendDist": "../.output",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Slate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": null,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "blur",
            "underWindowBackground"
          ],
          "radius": 10
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sdf"
        ],
        "description": "The Slate Document Format.",
        "name": "Slate Document Format",
        "role": "Editor"
      }
    ]
  }
}
