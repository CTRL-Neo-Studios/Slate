{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Slate",
  "version": "0.1.0",
  "identifier": "dev.ctrl-neo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run generate",
    "beforeDevCommand": "pnpm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Slate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": null,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "blur",
            "underWindowBackground"
          ],
          "radius": 10
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sdf"
        ],
        "description": "The Slate Document Format.",
        "name": "sdf",
        "role": "Editor",
        "mimeType": "text/sdf"
      }
    ]
  }
}
